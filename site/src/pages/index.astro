---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const LOREM =
  ' Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum. Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam.';

// Development timeline, oldest → newest. Rendered newest-first below.
const timeline = [
  {
    step: 1,
    date: '2025 · Step 01',
    title: 'Defining the Vehicle interface',
    tag: 'base/',
    image: 'timeline/step-1.svg',
    summary:
      'An abstract Vehicle contract — command(), stop(), observe() — plus an Observation data model. The whole stack builds on this.',
    journal:
      "I wanted to start from the smallest possible contract instead of a hardware SDK. If I could describe a robot as just three verbs — command it, stop it, observe it — then every planner and controller I write later stays honest and portable. Observation was the harder call: I kept it to a camera image, a front range reading and a timestamp. No premature fields. It felt slow to write so little, but this is the seam the rest of the project hangs on." + LOREM + LOREM,
  },
  {
    step: 2,
    date: '2025 · Step 02',
    title: 'The PiCar-X driver',
    tag: 'robots/',
    image: 'timeline/step-2.svg',
    summary:
      'A concrete adapter turning velocity + steering-angle commands into SunFounder servo and motor calls.',
    journal:
      "This is where the abstraction met a real, noisy machine. The PiCar-X thinks in servo values and motor duty cycles; my interface speaks m/s and radians. Writing the adapter forced me to admit how much I was hand-waving about units. I resisted the urge to 'fix' the vendor library and instead wrote a thin translation layer, so the mess stays quarantined in one file and the rest of the stack never sees it." + LOREM,
  },
  {
    step: 3,
    date: '2025 · Step 03',
    title: 'Calibrating velocity',
    tag: 'calibration_experiments/',
    image: 'timeline/step-3.svg',
    summary:
      'A bench experiment mapping commanded motor speed to real-world metres per second.',
    journal:
      "Nothing humbles you like a tape measure. I commanded fixed speeds, timed the car over a known distance, and the numbers were not linear the way I'd hoped. I stopped trying to derive the mapping and just measured it. This entry is really about a mindset shift: the code is only as trustworthy as the last time I validated it against the floor of my apartment." + LOREM + LOREM + LOREM,
  },
  {
    step: 4,
    date: '2025 · Step 04',
    title: 'Calibrating steering',
    tag: 'calibration_experiments/',
    image: 'timeline/step-4.svg',
    summary:
      'Mapping servo angle to an actual steering radius so a commanded turn matches reality.',
    journal:
      "Steering was subtler than velocity because the error compounds over a path, not a point. A few degrees of servo bias becomes a slow drift into the wall. I built a small validation script and watched the difference between what I asked for and what the geometry did. Getting this repeatable — same command, same arc — mattered more to me than getting it perfectly centred." + LOREM,
  },
  {
    step: 5,
    date: '2025 · Step 05',
    title: 'Documenting in the open',
    tag: 'site/',
    image: 'timeline/step-5.svg',
    summary:
      'This site — a running, honest log of the build rather than a polished pitch.',
    journal:
      "I didn't want a marketing page. I wanted a lab notebook that happens to be public, so the reasoning behind each step survives longer than my memory of it. If a future version of me — or anyone building on this — wants to know why a decision was made, it should be one card-flip away." + LOREM + LOREM,
  },
];

const entries = [...timeline].reverse(); // newest first
---

<Layout title="Classical Autonomy Stack">
  <header class="masthead">
    <div class="container">
      <p class="kicker">Classical (non-learned) autonomy · small autonomous vehicles</p>
      <h1>Classical Autonomy Stack</h1>
      <p class="sub">
        A build log for a transparent, hardware-agnostic autonomy stack —
        starting with the SunFounder PiCar-X. Most recent work is at the top;
        each step flips open to a short journal entry from my perspective.
      </p>
      <nav class="meta">
        <a href="https://github.com/herrnel/classical-autonomy-stack">Source ↗</a>
        <span class="hint">Tap a card to read the journal entry</span>
      </nav>
    </div>
  </header>

  <main class="container">
    <ol class="timeline">
      {entries.map((entry, i) => (
        <li class="row" id={i === entries.length - 1 ? 'beginning' : undefined}>
          <div class="rail" aria-hidden="true">
            <span class="dot"></span>
            <span class="num">{String(entry.step).padStart(2, '0')}</span>
          </div>

          <button class="card" type="button" aria-expanded="false">
            <div class="flip">
              <div class="face front">
                <div class="img" style={`background-image:url(${base}${entry.image})`}></div>
                <div class="body">
                  <div class="tagline">
                    <span class="date">{entry.date}</span>
                    <code class="tag">{entry.tag}</code>
                  </div>
                  <h2>{entry.title}</h2>
                  <p>{entry.summary}</p>
                  <span class="flip-hint">Journal →</span>
                </div>
              </div>

              <div class="face back">
                <div class="body">
                  <div class="tagline">
                    <span class="date">{entry.date}</span>
                    <span class="label">Journal</span>
                  </div>
                  <h2>{entry.title}</h2>
                  <p class="entry">{entry.journal}</p>
                  <span class="flip-hint">← Back</span>
                </div>
              </div>
            </div>
          </button>
        </li>
      ))}
    </ol>
  </main>

  <a class="jump" href="#beginning">↓ Jump to the beginning</a>

  <footer class="container">
    <p>Built with <a href="https://astro.build">Astro</a> · Deployed on GitHub Pages</p>
  </footer>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.card').forEach((card) => {
      card.addEventListener('click', () => {
        const flipped = card.classList.toggle('is-flipped');
        card.setAttribute('aria-expanded', String(flipped));
      });
    });
  </script>

  <style>
    /* ---- Masthead: stark, no glow, no buttons ---- */
    .masthead {
      padding: 4.5rem 0 3rem;
      border-bottom: 1px solid var(--border);
    }
    .kicker {
      margin: 0 0 1rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.72rem;
      color: var(--muted);
    }
    h1 {
      margin: 0 0 1rem;
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.05;
    }
    .sub {
      max-width: 60ch;
      margin: 0 0 1.5rem;
      color: var(--muted);
      font-size: 1.05rem;
    }
    .meta {
      display: flex;
      align-items: baseline;
      gap: 1.25rem;
      flex-wrap: wrap;
      font-size: 0.85rem;
    }
    .meta .hint { color: var(--muted); }

    /* ---- Timeline ---- */
    .timeline {
      list-style: none;
      margin: 0;
      padding: 3rem 0 4rem;
    }
    .row {
      display: grid;
      grid-template-columns: 3.25rem 1fr;
      gap: 1.25rem;
      padding-bottom: 2.5rem;
      scroll-margin-top: 2rem;
    }
    .row:last-child { padding-bottom: 0; }

    .rail {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 0.4rem;
    }
    .rail::before {
      content: '';
      position: absolute;
      top: 1.4rem;
      bottom: -2.5rem;
      width: 1px;
      background: var(--border);
    }
    .row:last-child .rail::before { display: none; }
    .dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid var(--accent);
      z-index: 1;
    }
    .num {
      margin-top: 0.5rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.72rem;
      color: var(--muted);
    }

    /* ---- Flip card (grows to fit the taller face) ---- */
    .card {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      color: inherit;
      text-align: left;
      cursor: pointer;
      perspective: 2000px;
    }
    /* Both faces share one grid cell, so the wrapper is as tall as
       whichever face has more content — cards grow, never clip. */
    .flip {
      display: grid;
      transform-style: preserve-3d;
      transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .card.is-flipped .flip { transform: rotateY(180deg); }

    .face {
      grid-area: 1 / 1;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      display: flex;
      flex-direction: column;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 4px;
      overflow: hidden;
    }
    .card:hover .face { border-color: #afb8c1; }
    .back { transform: rotateY(180deg); }

    .img {
      height: 190px;
      background-size: cover;
      background-position: center;
      border-bottom: 1px solid var(--border);
    }
    .body {
      padding: 1.1rem 1.3rem 1.2rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .back .body { padding-top: 1.3rem; }

    .tagline {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }
    .date {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.02em;
    }
    .tag {
      font-size: 0.72rem;
      padding: 0.05em 0.45em;
      color: var(--accent);
      background: transparent;
      border-color: var(--border);
    }
    .label {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--accent-2);
    }
    .card h2 {
      margin: 0 0 0.5rem;
      font-size: 1.15rem;
      font-weight: 650;
      letter-spacing: -0.01em;
    }
    .card p {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }
    .entry { font-size: 0.92rem; }
    .flip-hint {
      margin-top: auto;
      padding-top: 0.9rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.72rem;
      color: var(--accent);
    }

    @media (max-width: 560px) {
      .row { grid-template-columns: 2rem 1fr; gap: 0.85rem; }
    }

    /* ---- Fixed "jump to beginning" button ---- */
    .jump {
      position: fixed;
      left: 1.25rem;
      bottom: 1.25rem;
      z-index: 20;
      padding: 0.55rem 0.9rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text);
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 6px;
      box-shadow: 0 2px 8px rgba(31, 35, 40, 0.08);
    }
    .jump:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
    @media (max-width: 560px) {
      .jump { left: 0.75rem; bottom: 0.75rem; }
    }

    footer { padding: 2.5rem 0; text-align: center; color: var(--muted); border-top: 1px solid var(--border); }
  </style>
</Layout>
