---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

// Each timeline entry has a card (left rail) and a rich journal made of
// blocks. Supported block types: 'p' (paragraph), 'h' (subheading),
// 'code' (with a language label), 'img' and 'plot' (figure with caption).
const timeline = [
  {
    step: 1,
    date: '2025 · Step 01',
    title: 'Defining the Vehicle interface',
    tag: 'base/',
    image: 'timeline/step-1.svg',
    summary:
      'An abstract Vehicle contract — command(), stop(), observe() — plus an Observation data model.',
    blocks: [
      { type: 'p', text: "I wanted to start from the smallest possible contract instead of a hardware SDK. If I could describe a robot as just three verbs — command it, stop it, observe it — then every planner and controller I write later stays honest and portable." },
      { type: 'h', text: 'The contract' },
      { type: 'code', lang: 'base/vehicle.py', text: `from abc import ABC, abstractmethod
from observation import Observation

class Vehicle(ABC):
    @abstractmethod
    def command(self, velocity_mps: float, steering_rad: float):
        """Commands must contain velocity_mps and steering_rad"""

    @abstractmethod
    def stop(self): ...

    @abstractmethod
    def observe(self) -> Observation: ...` },
      { type: 'p', text: "Observation was the harder call: I kept it to a camera image, a front range reading and a timestamp. No premature fields. It felt slow to write so little, but this is the seam the rest of the project hangs on." },
      { type: 'code', lang: 'base/observation.py', text: `class Observation:
    def __init__(self, image, front_range_m, timestamp):
        self.__image = image
        self.__front_range_m = front_range_m
        self.__timestamp = timestamp` },
    ],
  },
  {
    step: 2,
    date: '2025 · Step 02',
    title: 'The PiCar-X driver',
    tag: 'robots/',
    image: 'timeline/step-2.svg',
    summary:
      'A concrete adapter turning velocity + steering-angle commands into SunFounder servo and motor calls.',
    blocks: [
      { type: 'p', text: "This is where the abstraction met a real, noisy machine. The PiCar-X thinks in servo values and motor duty cycles; my interface speaks m/s and radians." },
      { type: 'h', text: 'Translating units at the edge' },
      { type: 'code', lang: 'robots/picarx.py', text: `class PiCarX(Vehicle):
    def command(self, velocity_mps, steering_rad):
        self.px.forward(velocity_mps)
        self.set_steering_angle(steering_rad)

    def set_steering_angle(self, steering_rad):
        steering_deg = math.degrees(steering_rad)
        sunfounder_angle = -steering_deg          # sign flip
        self.px.set_dir_servo_angle(sunfounder_angle)` },
      { type: 'p', text: "I resisted the urge to 'fix' the vendor library and instead wrote a thin translation layer, so the mess stays quarantined in one file and the rest of the stack never sees it." },
      { type: 'img', src: 'timeline/step-2.svg', caption: 'PiCar-X on the bench during driver bring-up.' },
    ],
  },
  {
    step: 3,
    date: '2025 · Step 03',
    title: 'Calibrating velocity',
    tag: 'calibration_experiments/',
    image: 'timeline/step-3.svg',
    summary:
      'A bench experiment mapping commanded motor speed to real-world metres per second.',
    blocks: [
      { type: 'p', text: "Nothing humbles you like a tape measure. I commanded fixed speeds, timed the car over a known distance, and the numbers were not linear the way I'd hoped." },
      { type: 'plot', src: 'timeline/plot-velocity.svg', caption: 'Commanded speed vs. measured m/s — clearly non-linear at the low end.' },
      { type: 'p', text: "I stopped trying to derive the mapping and just measured it. This entry is really about a mindset shift: the code is only as trustworthy as the last time I validated it against the floor of my apartment." },
    ],
  },
  {
    step: 4,
    date: '2025 · Step 04',
    title: 'Calibrating steering',
    tag: 'calibration_experiments/',
    image: 'timeline/step-4.svg',
    summary:
      'Mapping servo angle to an actual steering radius so a commanded turn matches reality.',
    blocks: [
      { type: 'p', text: "Steering was subtler than velocity because the error compounds over a path, not a point. A few degrees of servo bias becomes a slow drift into the wall." },
      { type: 'plot', src: 'timeline/plot-steering.svg', caption: 'Measured arc vs. commanded servo angle (dashed = ideal linear response).' },
      { type: 'p', text: "I built a small validation script and watched the difference between what I asked for and what the geometry did. Getting this repeatable — same command, same arc — mattered more to me than getting it perfectly centred." },
    ],
  },
];

const entries = [...timeline].reverse(); // newest first
---

<Layout title="Classical Autonomy Stack">
  <header class="masthead">
    <div class="container">
      <p class="kicker">Classical (non-learned) autonomy · small autonomous vehicles</p>
      <h1>Classical Autonomy Stack</h1>
      <p class="sub">
        A build log for a transparent, hardware-agnostic autonomy stack —
        starting with the SunFounder PiCar-X. Most recent work is at the top;
        select a step to open its journal.
      </p>
      <nav class="meta">
        <a href="https://github.com/herrnel/classical-autonomy-stack">Source ↗</a>
        <span class="hint">Select a card to open its journal entry</span>
      </nav>
    </div>
  </header>

  <div class="workspace-wrap">
    <div class="workspace" id="workspace">
      <ol class="timeline">
        {entries.map((entry, i) => (
          <li class="row" id={i === entries.length - 1 ? 'beginning' : undefined}>
            <div class="rail" aria-hidden="true">
              <span class="dot"></span>
              <span class="num">{String(entry.step).padStart(2, '0')}</span>
            </div>
            <button class="card" type="button" id={`card-${entry.step}`} data-id={entry.step} aria-pressed="false">
              <div class="img" style={`background-image:url(${base}${entry.image})`}></div>
              <div class="body">
                <div class="tagline">
                  <span class="date">{entry.date}</span>
                  <code class="tag">{entry.tag}</code>
                </div>
                <h2>{entry.title}</h2>
                <p>{entry.summary}</p>
                <span class="open-hint">Open journal →</span>
              </div>
            </button>
          </li>
        ))}
      </ol>

      <aside class="panel" aria-live="polite">
        <div class="panel-inner">
          {entries.map((entry) => (
            <article class="detail" data-id={entry.step}>
              <div class="detail-head">
                <div>
                  <span class="date">{entry.date}</span>
                  <code class="tag">{entry.tag}</code>
                </div>
                <button class="close" type="button" aria-label="Close journal">Close ✕</button>
              </div>
              <h2 class="detail-title">{entry.title}</h2>
              {entry.blocks.map((b) => {
                if (b.type === 'h') return <h3 class="b-h">{b.text}</h3>;
                if (b.type === 'p') return <p class="b-p">{b.text}</p>;
                if (b.type === 'code') return (
                  <figure class="b-code">
                    <figcaption>{b.lang}</figcaption>
                    <pre><code>{b.text}</code></pre>
                  </figure>
                );
                // img or plot
                return (
                  <figure class="b-fig">
                    <img src={`${base}${b.src}`} alt={b.caption} loading="lazy" />
                    <figcaption>{b.caption}</figcaption>
                  </figure>
                );
              })}
            </article>
          ))}
        </div>
      </aside>
    </div>
  </div>

  <div class="jump-controls">
    <a class="jump" href="#beginning">↓ Jump to the beginning</a>
    <button class="jump current-jump" type="button">◎ Jump to current entry</button>
  </div>

  <footer class="container">
    <p>Built with <a href="https://astro.build">Astro</a> · Deployed on GitHub Pages</p>
  </footer>

  <script>
    const workspace = document.getElementById('workspace')!;
    const root = document.documentElement;
    const mast = document.querySelector<HTMLElement>('.masthead')!;
    const cards = workspace.querySelectorAll<HTMLButtonElement>('.card');
    const details = workspace.querySelectorAll<HTMLElement>('.detail');
    const currentJump = document.querySelector<HTMLButtonElement>('.current-jump')!;
    let activeCard: HTMLButtonElement | null = null;

    function setHeaderVar() {
      root.style.setProperty('--header-h', mast.offsetHeight + 'px');
    }
    setHeaderVar();
    window.addEventListener('resize', setHeaderVar);

    function select(id: string | null) {
      const on = id !== null;
      workspace.classList.toggle('has-selection', on);
      root.classList.toggle('reading', on);
      if (on) setHeaderVar();
      activeCard = null;
      cards.forEach((c) => {
        const isActive = c.dataset.id === id;
        c.classList.toggle('active', isActive);
        c.setAttribute('aria-pressed', String(isActive));
        if (isActive) activeCard = c;
      });
      details.forEach((d) => d.classList.toggle('active', d.dataset.id === id));
    }

    cards.forEach((c) =>
      c.addEventListener('click', () => {
        const already = c.classList.contains('active');
        select(already ? null : c.dataset.id ?? null);
      })
    );
    workspace.querySelectorAll<HTMLButtonElement>('.close').forEach((b) =>
      b.addEventListener('click', () => select(null))
    );
    currentJump.addEventListener('click', () =>
      activeCard?.scrollIntoView({ behavior: 'smooth', block: 'center' })
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') select(null);
    });
  </script>

  <style>
    .masthead { padding: 4.5rem 0 3rem; border-bottom: 1px solid var(--border); }
    /* In reading mode the header pins to the top and the timeline scrolls under it */
    :global(html.reading) .masthead {
      position: sticky; top: 0; z-index: 30;
      background: var(--bg);
      padding: 1.5rem 0;
    }
    :global(html.reading) .masthead .sub,
    :global(html.reading) .masthead .kicker { display: none; }
    .kicker { margin: 0 0 1rem; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.72rem; color: var(--muted); }
    h1 { margin: 0 0 1rem; font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; }
    .sub { max-width: 60ch; margin: 0 0 1.5rem; color: var(--muted); font-size: 1.05rem; }
    .meta { display: flex; align-items: baseline; gap: 1.25rem; flex-wrap: wrap; font-size: 0.85rem; }
    .meta .hint { color: var(--muted); }

    /* ---- Workspace: timeline (left) + journal panel (right) ---- */
    .workspace-wrap { padding: 0 2rem; }
    .workspace {
      display: flex;
      align-items: flex-start;
      justify-content: center;   /* centred when nothing is selected */
      gap: 3rem;
      padding: 3rem 0 4rem;
    }
    .workspace.has-selection { justify-content: flex-start; }
    .timeline {
      list-style: none;
      margin: 0;
      padding: 0;
      flex: 0 0 600px;           /* card column keeps the same width/shape in both states */
      max-width: 600px;
      width: 100%;
    }

    .row { display: grid; grid-template-columns: 3.25rem 1fr; gap: 1.25rem; padding-bottom: 2.5rem; scroll-margin-top: calc(var(--header-h, 2rem) + 1.5rem); }
    .row:last-child { padding-bottom: 0; }
    .rail { position: relative; display: flex; flex-direction: column; align-items: center; padding-top: 0.4rem; }
    .rail::before { content: ''; position: absolute; top: 1.4rem; bottom: -2.5rem; width: 1px; background: var(--border); }
    .row:last-child .rail::before { display: none; }
    .dot { width: 11px; height: 11px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); z-index: 1; }
    .num { margin-top: 0.5rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; color: var(--muted); }

    /* ---- Card ---- */
    .card {
      display: block; width: 100%; padding: 0; border: 1px solid var(--border);
      background: var(--panel); font: inherit; color: inherit; text-align: left;
      cursor: pointer; border-radius: 4px; overflow: hidden;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .card:hover { border-color: #afb8c1; }
    .card.active { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
    .img { height: 170px; background-size: cover; background-position: center; border-bottom: 1px solid var(--border); }
    .body { padding: 1.1rem 1.3rem 1.2rem; }
    .tagline { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
    .date { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; color: var(--muted); }
    .tag { font-size: 0.72rem; padding: 0.05em 0.45em; color: var(--accent); background: transparent; border-color: var(--border); }
    .card h2 { margin: 0 0 0.5rem; font-size: 1.15rem; font-weight: 650; letter-spacing: -0.01em; }
    .card p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.55; }
    .open-hint { display: inline-block; margin-top: 0.9rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; color: var(--accent); }

    /* ---- Journal panel ---- */
    .panel {
      flex: 0 0 0; width: 0; opacity: 0; overflow: hidden;
      transition: flex-basis 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.35s;
      align-self: stretch;
    }
    .has-selection .panel { flex: 1 1 auto; width: auto; opacity: 1; }
    .panel-inner {
      position: sticky; top: calc(var(--header-h, 1.5rem) + 1rem);
      background: transparent;
      max-height: calc(100vh - var(--header-h, 0px) - 2rem); overflow-y: auto;
    }
    .detail { display: none; padding: 0.25rem 0.5rem 2rem 0; }
    .detail.active { display: block; }
    .detail-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem; }
    .detail-head > div { display: flex; align-items: center; gap: 0.75rem; }
    .close { border: 1px solid var(--border); background: var(--panel); color: var(--muted); font: inherit; font-size: 0.78rem; padding: 0.3rem 0.6rem; border-radius: 6px; cursor: pointer; }
    .close:hover { border-color: var(--accent); color: var(--accent); }
    .detail-title { margin: 0 0 1.25rem; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
    .b-h { margin: 1.75rem 0 0.6rem; font-size: 1rem; font-weight: 650; }
    .b-p { margin: 0 0 1rem; color: #3d444d; line-height: 1.7; }
    .b-code { margin: 0 0 1.25rem; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
    .b-code figcaption { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; color: var(--muted); padding: 0.45rem 0.9rem; background: #f6f8fa; border-bottom: 1px solid var(--border); }
    .b-code pre { margin: 0; padding: 1rem 1.1rem; overflow-x: auto; background: #f6f8fa; }
    .b-code pre code { background: transparent; border: 0; padding: 0; font-size: 0.82rem; line-height: 1.65; color: #1f2328; }
    .b-fig { margin: 0 0 1.25rem; }
    .b-fig img { width: 100%; border: 1px solid var(--border); border-radius: 6px; display: block; }
    .b-fig figcaption { margin-top: 0.5rem; font-size: 0.8rem; color: var(--muted); text-align: center; }

    /* ---- Responsive: panel becomes a full overlay ---- */
    @media (max-width: 820px) {
      .workspace-wrap { padding: 0 1.5rem; }
      .workspace { gap: 0; justify-content: center; }
      .workspace.has-selection { justify-content: center; }
      .has-selection .timeline { flex: 0 0 auto; margin: 0 auto; }
      .panel { position: fixed; inset: 0; z-index: 40; flex: none; width: 100vw; background: rgba(0,0,0,0.25); padding: 0; }
      .panel-inner { position: absolute; inset: 0; border-radius: 0; max-height: none; border: 0; background: var(--panel); }
      .detail { min-height: 100%; padding: 1.5rem 1.75rem 2rem; }
    }
    @media (max-width: 560px) {
      .row { grid-template-columns: 2rem 1fr; gap: 0.85rem; }
    }

    /* ---- Fixed jump controls (bottom-left) ---- */
    .jump-controls { position: fixed; left: 1.25rem; bottom: 1.25rem; z-index: 20; display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
    .jump { padding: 0.55rem 0.9rem; font: inherit; font-size: 0.8rem; font-weight: 600; color: var(--text); background: var(--panel); border: 1px solid var(--border); border-radius: 6px; box-shadow: 0 2px 8px rgba(31,35,40,0.08); cursor: pointer; }
    .jump:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
    .current-jump { display: none; }
    :global(html.reading) .current-jump { display: inline-block; }
    @media (max-width: 560px) { .jump-controls { left: 0.75rem; bottom: 0.75rem; } }

    footer { padding: 2.5rem 0; text-align: center; color: var(--muted); border-top: 1px solid var(--border); }
  </style>
</Layout>
