---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

// Content lives in one Markdown file per step under src/entries/.
// Edit those files to change the site — no code changes needed.
const modules = Object.values(
  import.meta.glob('../entries/*.md', { eager: true })
) as any[];

function readingTime(mod: any): string {
  const raw = typeof mod.rawContent === 'function' ? mod.rawContent() : (mod.compiledContent?.() ?? '');
  const words = String(raw).trim().split(/\s+/).filter(Boolean).length;
  const mins = Math.max(1, Math.round(words / 200)); // ~200 wpm
  return `${mins} min read`;
}

const items = modules
  .sort((a, b) => b.frontmatter.step - a.frontmatter.step) // newest first
  .map((m) => ({ ...m.frontmatter, Content: m.Content, readTime: readingTime(m) }));
---

<Layout title="Classical Autonomy Stack">
  <header class="masthead">
    <div class="container">
      <p class="kicker">Classical (non-learned) autonomy · small autonomous vehicles</p>
      <h1>Classical Autonomy Stack</h1>
      <p class="sub">
        A build log for a transparent, hardware-agnostic autonomy stack —
        starting with the SunFounder PiCar-X. Most recent work is at the top;
        select a step to open its journal.
      </p>
      <nav class="meta">
        <a href="https://github.com/herrnel/classical-autonomy-stack">Source ↗</a>
        <span class="hint">Select a card to open its journal entry</span>
        <button class="view-full" type="button">View full timeline ↗</button>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode"></button>
      </nav>
    </div>
  </header>

  <div class="workspace-wrap">
    <div class="workspace" id="workspace">
      <nav class="mini" aria-label="Condensed timeline">
        {items.map((f) => (
          <button class="mini-item" type="button" data-id={f.step}>
            <span class="mini-label">{String(f.step).padStart(2, '0')} · {f.title}</span>
          </button>
        ))}
      </nav>
      <ol class="timeline">
        {items.map((f, i) => (
          <li class="row" id={i === items.length - 1 ? 'beginning' : undefined}>
            <div class="rail" aria-hidden="true">
              <span class="dot"></span>
              <span class="num">{String(f.step).padStart(2, '0')}</span>
            </div>
            <button class="card" type="button" id={`card-${f.step}`} data-id={f.step} aria-pressed="false">
              <div class="img" style={`background-image:url(${base}${f.image})`}></div>
              <div class="body">
                <div class="tagline">
                  <span class="date">{f.date}</span>
                  <code class="tag">{f.tag}</code>
                </div>
                <h2>{f.title}</h2>
                <p>{f.summary}</p>
                <span class="open-hint">Open journal →</span>
              </div>
            </button>
          </li>
        ))}
      </ol>

      <aside class="panel" aria-live="polite">
        <div class="panel-inner">
          {items.map((f) => {
            const Content = f.Content;
            return (
            <article class="detail" data-id={f.step}>
              <div class="detail-head">
                <span class="date">{f.date}</span>
                <span class="read-time">{f.readTime}</span>
              </div>
              <h2 class="detail-title">{f.title}</h2>
              <p class="detail-summary">{f.summary}</p>
              <div class="prose">
                <Content />
              </div>
            </article>
            );
          })}
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    // Restore the saved reading state before first paint to avoid a flash of
    // the full timeline / newest card on refresh.
    (function () {
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      var saved = localStorage.getItem('selectedStep');
      if (saved === '__none__') return; // was on the full timeline
      var card = saved ? document.querySelector('.card[data-id="' + saved + '"]') : null;
      if (!card) { card = document.querySelector('.card'); } // default: newest
      if (!card) return;
      var id = card.getAttribute('data-id');
      document.documentElement.classList.add('reading');
      var ws = document.getElementById('workspace');
      if (ws) ws.classList.add('has-selection');
      document.querySelectorAll('[data-id="' + id + '"]').forEach(function (el) {
        if (el.classList.contains('card') || el.classList.contains('detail') || el.classList.contains('mini-item')) {
          el.classList.add('active');
        }
      });
      card.setAttribute('aria-pressed', 'true');
      window.scrollTo(0, 0);
    })();
  </script>

  <div class="jump-controls">
    <a class="jump" href="#beginning">↓ Jump to the beginning</a>
  </div>

  <footer class="container">
    <p>Built with <a href="https://astro.build">Astro</a> · Deployed on GitHub Pages</p>
  </footer>

  <div class="lightbox" id="lightbox" hidden>
    <img alt="" />
  </div>

  <script>
    const workspace = document.getElementById('workspace')!;
    const root = document.documentElement;
    const mast = document.querySelector<HTMLElement>('.masthead')!;
    const cards = workspace.querySelectorAll<HTMLButtonElement>('.card');
    const details = workspace.querySelectorAll<HTMLElement>('.detail');
    const miniItems = workspace.querySelectorAll<HTMLButtonElement>('.mini-item');
    const viewFull = document.querySelector<HTMLButtonElement>('.view-full')!;
    const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
    let activeCard: HTMLButtonElement | null = null;

    function syncTheme() {
      themeToggle.textContent = root.dataset.theme === 'dark' ? '☀ Light' : '☾ Dark';
    }
    syncTheme();
    themeToggle.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
      syncTheme();
    });

    function setHeaderVar() {
      root.style.setProperty('--header-h', mast.offsetHeight + 'px');
    }
    setHeaderVar();
    window.addEventListener('resize', setHeaderVar);

    function select(id: string | null) {
      const on = id !== null;
      workspace.classList.toggle('has-selection', on);
      root.classList.toggle('reading', on);
      if (on) setHeaderVar();
      activeCard = null;
      cards.forEach((c) => {
        const isActive = c.dataset.id === id;
        c.classList.toggle('active', isActive);
        c.setAttribute('aria-pressed', String(isActive));
        if (isActive) activeCard = c;
      });
      details.forEach((d) => d.classList.toggle('active', d.dataset.id === id));
      miniItems.forEach((m) => m.classList.toggle('active', m.dataset.id === id));
      localStorage.setItem('selectedStep', id ?? '__none__');
    }

    cards.forEach((c) =>
      c.addEventListener('click', () => {
        if (c.classList.contains('active')) return; // clicking the current card does nothing
        select(c.dataset.id ?? null);
      })
    );
    workspace.querySelectorAll<HTMLButtonElement>('.close').forEach((b) =>
      b.addEventListener('click', () => select(null))
    );
    viewFull.addEventListener('click', () => select(null));
    miniItems.forEach((m) =>
      m.addEventListener('click', () => {
        select(m.dataset.id ?? null);
        activeCard?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      })
    );
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!lightbox.hidden) closeLightbox();
      else select(null);
    });

    // ---- Lightbox: click any journal image to enlarge ----
    const lightbox = document.getElementById('lightbox') as HTMLElement;
    const lightboxImg = lightbox.querySelector('img') as HTMLImageElement;
    function closeLightbox() {
      lightbox.hidden = true;
      lightboxImg.removeAttribute('src');
    }
    workspace.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) =>
      img.addEventListener('click', () => {
        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = img.alt;
        lightbox.hidden = false;
      })
    );
    lightbox.addEventListener('click', closeLightbox);

    // Restore the last-viewed entry on refresh (falls back to the newest)
    const saved = localStorage.getItem('selectedStep');
    if (saved === '__none__') {
      select(null);
    } else if (saved && Array.from(cards).some((c) => c.dataset.id === saved)) {
      select(saved);
    } else {
      select(cards[0]?.dataset.id ?? null);
    }
  </script>

  <style>
    .masthead { padding: 4.5rem 0 3rem; border-bottom: 1px solid var(--border); }
    /* In reading mode the header is a thin bar: small title on the left,
       links inline on the right; the timeline scrolls under it */
    :global(html.reading) .masthead {
      position: sticky; top: 0; z-index: 30;
      background: var(--header-bg);
      box-shadow: 0 3px 4px rgba(0, 0, 0, 0.88);
      padding: 0.4rem 0;
    }
    :global(html.reading) .masthead .sub,
    :global(html.reading) .masthead .kicker,
    :global(html.reading) .masthead .hint { display: none; }
    :global(html.reading) .masthead .container { max-width: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 1.25rem; }
    :global(html.reading) .masthead h1 { font-size: 1rem; margin: 0; }
    :global(html.reading) .masthead .meta { margin: 0; }
    /* Control to close the journal and view all cards */
    .view-full { display: none; font: inherit; font-size: 0.8rem; font-weight: 600; color: var(--text); background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 0.35rem 0.7rem; cursor: pointer; }
    .view-full:hover { border-color: var(--accent); color: var(--accent); }
    :global(html.reading) .view-full { display: inline-block; }
    .kicker { margin: 0 0 1rem; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.72rem; color: var(--muted); }
    h1 { margin: 0 0 1rem; font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; }
    .sub { max-width: 60ch; margin: 0 0 1.5rem; color: var(--muted); font-size: 1.05rem; }
    .meta { display: flex; align-items: baseline; gap: 1.25rem; flex-wrap: wrap; font-size: 0.85rem; }
    .meta .hint { color: var(--muted); }
    .theme-toggle { font: inherit; font-size: 0.8rem; font-weight: 600; color: var(--text); background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 0.3rem 0.7rem; cursor: pointer; }
    .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }

    /* ---- Workspace: timeline (left) + journal panel (right) ---- */
    .workspace-wrap { padding: 0 2rem; }
    /* Reading mode leaves room on the left for the condensed rail */
    :global(html.reading) .workspace-wrap { padding-left: 2rem; }
    .workspace {
      display: flex;
      align-items: flex-start;
      justify-content: center;   /* centred when nothing is selected */
      gap: 3rem;
      padding: 3rem 0 4rem;
    }
    .workspace.has-selection { justify-content: flex-start; }
    .timeline {
      list-style: none;
      margin: 0;
      padding: 0;
      flex: 0 0 600px;           /* card column keeps the same width/shape in both states */
      max-width: 600px;
      width: 100%;
    }

    .row { display: grid; grid-template-columns: 3.25rem 1fr; gap: 1.25rem; padding-bottom: 2.5rem; scroll-margin-top: calc(var(--header-h, 2rem) + 1.5rem); }
    .row:last-child { padding-bottom: 0; }
    .rail { position: relative; display: flex; flex-direction: column; align-items: center; padding-top: 0.4rem; }
    .rail::before { content: ''; position: absolute; top: 1.4rem; bottom: -2.5rem; width: 1px; background: var(--border); }
    .row:last-child .rail::before { display: none; }
    .dot { width: 11px; height: 11px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); z-index: 1; }
    .num { margin-top: 0.5rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; color: var(--muted); }

    /* ---- Card ---- */
    .card {
      display: block; width: 100%; padding: 0; border: 1px solid var(--border);
      background: var(--panel); font: inherit; color: inherit; text-align: left;
      cursor: pointer; border-radius: 4px; overflow: hidden;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .card:hover { border-color: #afb8c1; }
    .card.active { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
    .img { height: 170px; background-size: cover; background-position: center; border-bottom: 1px solid var(--border); }
    .body { padding: 1.1rem 1.3rem 1.2rem; }
    .tagline { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
    .date { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; color: var(--muted); }
    .tag { font-size: 0.72rem; padding: 0.05em 0.45em; color: var(--accent); background: transparent; border-color: var(--border); }
    .card h2 { margin: 0 0 0.5rem; font-size: 1.15rem; font-weight: 650; letter-spacing: -0.01em; }
    .card .tag { display: none; }   /* no file/folder link on the timeline cards */
    .card p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.55; }
    .open-hint { display: inline-block; margin-top: 0.9rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; color: var(--accent); }

    /* ---- Journal panel ---- */
    .panel {
      flex: 0 0 0; width: 0; opacity: 0; overflow: hidden;
      transition: flex-basis 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.35s;
      align-self: stretch;
    }
    .has-selection .panel { flex: 1 1 auto; width: auto; opacity: 1; }
    .panel-inner {
      position: sticky; top: calc(var(--header-h, 1.5rem) + 1rem);
      background: transparent;
      max-height: calc(100vh - var(--header-h, 0px) - 2rem); overflow-y: auto;
    }
    /* Reading mode (desktop): the journal is normal page content (the page/
       background scrolls it), while the timeline is a fixed box that scrolls
       its own content independently. */
    @media (min-width: 821px) {
      :global(html.reading) .has-selection .panel-inner {
        position: static; max-height: none; overflow: visible; top: auto;
      }
      :global(html.reading) .has-selection .panel {
        --jw: 50rem;            /* journal column width */
        flex: none;
        width: var(--jw);
        margin-left: auto;      /* centre the journal on screen */
        margin-right: auto;
        transform: translateX(-105px);  /* shift the journal slightly left */
        opacity: 1;
      }
      :global(html.reading) .has-selection .timeline {
        position: fixed;
        top: calc(var(--header-h, 1.5rem) + 1rem);
        bottom: 1rem;
        left: 3.1rem;           /* nudged slightly right, still clear of the mini timeline */
        right: calc(50% + 25rem + 4rem);
        flex: none; width: auto; max-width: none;
        display: flex; flex-direction: column; justify-content: safe center;  /* vertically centre the cards */
        align-items: flex-start;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding-right: 0.5rem;
      }
      /* Compact cards while reading: no image, tighter, left-aligned */
      :global(html.reading) .has-selection .row { grid-template-columns: 1.2rem 1fr; gap: 0.6rem; padding-bottom: 1.1rem; width: 17rem; max-width: 100%; margin: 0; }
      :global(html.reading) .has-selection .card .img { display: none; }
      :global(html.reading) .has-selection .card .body { padding: 0.75rem 0.95rem; }
      :global(html.reading) .has-selection .card h2 { font-size: 0.95rem; margin-bottom: 0.2rem; }
      :global(html.reading) .has-selection .card p,
      :global(html.reading) .has-selection .card .open-hint { display: none; }
    }
    .detail { display: none; padding: 3rem 0.5rem 2rem 0; }
    .detail.active { display: block; }
    .detail-head { display: flex; flex-direction: column; align-items: flex-end; gap: 0.15rem; margin-bottom: 0.75rem; }
    .detail-head > div { display: flex; align-items: center; gap: 0.75rem; }
    .read-time { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; color: var(--muted); }
    .close { border: 1px solid var(--border); background: var(--panel); color: var(--muted); font: inherit; font-size: 0.78rem; padding: 0.3rem 0.6rem; border-radius: 6px; cursor: pointer; }
    .close:hover { border-color: var(--accent); color: var(--accent); }
    .detail-title { margin: 0 0 1.5rem; font-family: Georgia, 'Times New Roman', serif; font-size: 1.9rem; font-weight: 700; letter-spacing: -0.01em; line-height: 1.15; }
    .detail-summary { margin: 0 0 1.5rem; font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 1.05rem; color: var(--text); line-height: 1.5; max-width: 70ch; }
    /* Rendered Markdown journal body (Shiki/markdown HTML has no scope id, so use :global) */
    .prose { max-width: 70ch; font-family: Georgia, 'Times New Roman', serif; font-size: 1.1rem; letter-spacing: 0.015em; -webkit-font-smoothing: antialiased; }
    .prose :global(h2), .prose :global(h3) { margin: 1.75rem 0 0.6rem; font-size: 1.05rem; font-weight: 650; color: var(--accent-2); clear: both; }
    .prose :global(p) { margin: 0 0 1rem; color: var(--prose); line-height: 1.65; font-weight: 400; }
    .prose :global(:not(pre) > code) { background: transparent; border: 0; padding: 0.05em 0.15em; font-size: 0.82em; color: var(--accent); }
    .prose :global(pre) { margin: 0 0 1.25rem; padding: 0.9rem 1.1rem; overflow-x: auto; border: 1px solid var(--border); border-radius: 6px; clear: both; }
    .prose :global(pre code) { background: transparent; border: 0; padding: 0; font-size: 0.82rem; line-height: 1.45; }
    .prose :global(img) { max-width: 360px; width: 100%; height: auto; border: 1px solid var(--border); border-radius: 6px; display: block; margin: 0.25rem auto 0.4rem; cursor: zoom-in; }
    /* An italic line right after an image acts as its caption */
    .prose :global(img + em), .prose :global(p > em:only-child) { display: block; font-size: 0.8rem; font-style: normal; color: var(--muted); text-align: center; margin: 0 0 1.25rem; }
    .prose :global(ul), .prose :global(ol) { color: var(--prose); line-height: 1.65; margin: 0 0 1rem; padding-left: 1.6rem; margin-left: 1.25rem; }
    .prose :global(li) { margin: 0.2rem 0; }
    .prose :global(li > ul), .prose :global(li > ol) { margin: 0.25rem 0 0.4rem; }
    .prose :global(a) { color: var(--accent); }
    /* Blockquotes ( > lines ) get a clean accent treatment */
    .prose :global(blockquote) { margin: 0 0 1.25rem; padding: 0.6rem 1rem; border-left: 3px solid var(--accent); background: var(--note-bg); color: var(--prose); border-radius: 0 6px 6px 0; clear: both; }
    .prose :global(blockquote p) { margin: 0; }
    .prose :global(strong) { color: var(--text); }
    /* Wrap text around an image: <figure class="wrap-right"> or wrap-left */
    .prose :global(figure.wrap-right), .prose :global(figure.wrap-left) { max-width: 45%; margin: 0.2rem 0 0.8rem; }
    .prose :global(figure.wrap-right) { float: right; margin-left: 1.3rem; }
    .prose :global(figure.wrap-left) { float: left; margin-right: 1.3rem; }
    .prose :global(figure img) { margin: 0; max-width: 100%; cursor: zoom-in; }
    .prose :global(figure figcaption) { font-size: 0.78rem; color: var(--muted); text-align: center; margin-top: 0.35rem; }
    .prose :global(.clear) { clear: both; }
    .prose::after { content: ''; display: block; clear: both; }

    /* ---- Responsive: panel becomes a full overlay ---- */
    @media (max-width: 820px) {
      .workspace-wrap { padding: 0 1.5rem; }
      .workspace { gap: 0; justify-content: center; }
      .workspace.has-selection { justify-content: center; }
      .has-selection .timeline { flex: 0 0 auto; margin: 0 auto; }
      .panel { position: fixed; inset: 0; z-index: 40; flex: none; width: 100vw; background: rgba(0,0,0,0.25); padding: 0; }
      .panel-inner { position: absolute; inset: 0; border-radius: 0; max-height: none; border: 0; background: var(--panel); }
      .detail { min-height: 100%; padding: 1.5rem 1.75rem 2rem; }
    }
    @media (max-width: 560px) {
      .row { grid-template-columns: 2rem 1fr; gap: 0.85rem; }
    }

    /* ---- Condensed timeline rail (always visible, vertically centred) ---- */
    .mini {
      display: flex; flex-direction: column; gap: 0.55rem;
      position: fixed; left: 1rem; top: 50%; transform: translateY(-50%);
      z-index: 25;
    }
    .mini-item {
      position: relative; width: 20px; height: 9px; padding: 0;
      border: 1px solid var(--border); border-radius: 5px;
      background: var(--border); cursor: pointer;
      transition: background 0.15s, border-color 0.15s, width 0.15s;
    }
    .mini-item:hover { background: var(--muted); }
    .mini-item.active { background: var(--accent); border-color: var(--accent); }
    .mini-label {
      position: absolute; left: calc(100% + 0.5rem); top: 50%; transform: translateY(-50%);
      white-space: nowrap; pointer-events: none;
      background: var(--text); color: var(--bg);
      font-size: 0.72rem; font-weight: 600;
      padding: 0.3rem 0.55rem; border-radius: 5px;
      opacity: 0; transition: opacity 0.15s;
      box-shadow: 0 2px 8px rgba(31,35,40,0.18);
    }
    .mini-item:hover .mini-label,
    .mini-item:focus-visible .mini-label { opacity: 1; }

    /* ---- Fixed jump controls (bottom-left) ---- */
    .jump-controls { position: fixed; left: 1.25rem; bottom: 1.25rem; z-index: 20; display: flex; flex-direction: row; gap: 0.5rem; align-items: center; }
    .jump { padding: 0.55rem 0.9rem; font: inherit; font-size: 0.8rem; font-weight: 600; color: var(--text); background: var(--panel); border: 1px solid var(--border); border-radius: 6px; box-shadow: 0 2px 8px rgba(31,35,40,0.08); cursor: pointer; }
    .jump:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
    @media (max-width: 560px) { .jump-controls { left: 0.75rem; bottom: 0.75rem; } }

    footer { padding: 2.5rem 0; text-align: center; color: var(--muted); border-top: 1px solid var(--border); }

    /* ---- Lightbox (click any journal image to enlarge) ---- */
    .lightbox { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 2rem; background: rgba(13, 17, 23, 0.82); cursor: zoom-out; }
    .lightbox[hidden] { display: none; }
    .lightbox img { max-width: 95vw; max-height: 92vh; border-radius: 6px; box-shadow: 0 12px 40px rgba(0,0,0,0.5); }
  </style>
</Layout>
